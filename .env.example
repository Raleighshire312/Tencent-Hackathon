# IntentLock — environment configuration
# Copy this file to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit a populated `.env`. NEVER paste real credentials into screenshots.

# Tencent Cloud ADP / 智能体开发平台
# Optional: leave blank to run in offline regex mode.
ADP_APP_KEY=
ADP_GUARDIAN_APP_KEY=
ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_GUARDIAN_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_VISITOR_ID=intentlock-demo-user
ADP_MODEL=
# Soft cap on ADP response body size (bytes). Default 16384.
ADP_MAX_RESPONSE_BYTES=1048576
# Soft cap on ADP round-trip time (ms). Default 15000.
ADP_TIMEOUT_MS=15000

# Security execution mode. OFFLINE_DEMO is explicit and makes no AI request.
# LIVE requires ADP_APP_KEY and fails closed if ADP is unavailable or invalid.
INTENTLOCK_MODE=OFFLINE_DEMO

# Mock bank fingerprint (debug aid — change any time)
INTENTLOCK_BANK_FINGERPRINT_SALT=local-dev-salt

# Server
PORT=8787

# Optional Tencent TRTC ASR/TTS integration. Keep all secrets server-side.
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=
TRTC_SECRET_ID=
TRTC_SECRET_KEY=
TRTC_REGION=ap-singapore

# Native passkeys are preferred. Enable only the clearly labelled demo signer locally.
ALLOW_AUTH_SIMULATOR=false
ALLOW_RISK_SIMULATOR=false
INTENTLOCK_DB_PATH=./data/intentlock.sqlite
